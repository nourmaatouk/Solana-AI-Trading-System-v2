.ipynb_checkpoints/
*.ipynb

# ─── OS noise ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDE / editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

