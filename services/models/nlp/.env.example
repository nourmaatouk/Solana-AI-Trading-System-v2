# NLP Sentiment Module - Environment Variables

# Application Config
APP_ENV=development
LOG_LEVEL=INFO

# RSS Feeds List (Comma-separated)
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cryptoslate.com/feed/,https://cointelegraph.com/feed/

# GDELT Configuration
GDELT_KEYWORDS=Solana,SOL token,Solana blockchain
GDELT_FETCH_INTERVAL_MINUTES=5

# FinBERT Settings
MAX_TEXT_LENGTH=512
SENTIMENT_THRESHOLD=0.1

# Storage Paths and Timing
OUTPUT_DIR=data/processed
RAW_DIR=data/raw
TIMEFRAME_MINUTES=15

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600

# TimescaleDB
TIMESCALE_DSN=postgresql://postgres:password@localhost:5432/trading

# Reddit Fetcher
REDDIT_SUBREDDITS=solana,CryptoCurrency,CryptoMarkets
REDDIT_FETCH_ENABLED=true
