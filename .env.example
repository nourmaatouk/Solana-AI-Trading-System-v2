# =============================================================================
# Solvanta AI Trading System — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env
#
# NEVER commit a real `.env`. Never put a real private key in a committed file.
# Secrets (API keys, private keys, DB passwords) belong only in the local,
# gitignored `.env` files — never in `.env.example`.
#
# Three services read their own `.env`:
#   - root / FastAPI ...... this file's keys
#   - apps/trading-dashboard/backend/.env ... Node backend (mirrors many keys)
#   - services/execution/.env ............... execution layer (wallet + narration)
# =============================================================================

# ── API auth ──────────────────────────────────────────────────────────────────
# Shared secret the Node backend + execution layer send as X-API-Key to FastAPI.
# Generate one with:  openssl rand -hex 32
# API_KEY and PYTHON_API_KEY MUST be identical.
API_KEY=replace_with_openssl_rand_hex_32
PYTHON_API_KEY=replace_with_openssl_rand_hex_32

# ── API / CORS ──────────────────────────────────────────────────────────────--
# Comma-separated allowed origins for the FastAPI backend.
# In production, list only the domains that serve the dashboard.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# ── Trading parameters ──────────────────────────────────────────────────────--
ACTIVE_SYMBOL=SOL/USDT
BTC_SYMBOL=BTC/USDT
EXCHANGE=binance
CONFIDENCE_THRESHOLD=0.69
TAKE_PROFIT_PCT=0.020
STOP_LOSS_PCT=0.015

# ── Backend services ──────────────────────────────────────────────────────────
PYTHON_API=http://localhost:8000
PORT=3001
BACKEND_URL=http://localhost:3001
KLINES_LIMIT=500

# ── Exchange endpoints ──────────────────────────────────────────────────────--
BINANCE_WS_HOST=wss://stream.binance.com:9443
BINANCE_REST_HOST=https://api.binance.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public

# ── Spoofing detection ──────────────────────────────────────────────────────--
DEFAULT_ASSETS=BTC,ETH,SOL

# ── NLP / Sentiment storage ─────────────────────────────────────────────────--
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_SECONDS=3600
# Use a STRONG password for any non-local Postgres. Do not ship a weak default.
TIMESCALE_DSN=postgresql://postgres:CHANGE_ME@localhost:5432/trading

# ── Agentic execution layer ─────────────────────────────────────────────────--
WALLET_MODE=phantom            # phantom | system | paper
EXECUTION_MODE=paper           # paper | devnet | mainnet
REQUIRE_GUARDIAN_APPROVAL=true
ALLOW_MAINNET_EXECUTION=false  # keep false unless you intend to move real funds
EMERGENCY_STOP=false
ENABLE_ELIZA_NARRATION=false

# ── LLM narration providers (optional; used by services/execution) ──────────--
# Ollama (free, local) is tried first, then Anthropic, then a deterministic stub.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# ANTHROPIC_API_KEY=           # optional paid fallback; leave blank to skip
ANTHROPIC_SMALL_MODEL=claude-3-5-haiku-20241022
ENABLE_LLM_NARRATION_FALLBACK_STUB=true

# ── Solana network ──────────────────────────────────────────────────────────--
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# The keypair below belongs ONLY in services/execution/.env — never here.
# SOLANA_PUBLIC_KEY=
# SOLANA_PRIVATE_KEY=

# ── Execution limits (Guardian policy) ──────────────────────────────────────--
MAX_TRADE_SIZE_SOL=0.1
MAX_DAILY_LOSS_SOL=0.5
MAX_SPOOFING_CONFIDENCE=0.15
SIGNAL_MAX_AGE_SECONDS=300
ALLOWED_ASSETS=SOL/USDT
DEVNET_AIRDROP_AMOUNT_SOL=1
MAX_DEVNET_AIRDROP_SOL=2

# ── Jupiter DEX integration ─────────────────────────────────────────────────--
# Real Jupiter v6 swaps. When false, devnet uses a self-transfer path check only.
# Jupiter programs are mainnet-only — when enabling, also point SOLANA_RPC_URL/
# SOLANA_CLUSTER at mainnet-beta.
JUPITER_SWAP_ENABLED=false
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_SLIPPAGE_BPS=50
# USDC (mainnet). For SOL/USDT pairs use Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
QUOTE_CURRENCY_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── On-chain Guardian (future) ──────────────────────────────────────────────--
# Leave empty until the Anchor program is deployed. The Guardian currently runs
# off-chain (TypeScript) in services/execution/src/guardian.
GUARDIAN_PROGRAM_ID=

# ── Frontend (Vite) ─────────────────────────────────────────────────────────--
# ONLY VITE_-prefixed keys are exposed to the browser build. Never put a secret
# behind a VITE_ prefix — it ships to every client.
VITE_ACTIVE_SYMBOL=SOLUSDT
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_ENABLE_PHANTOM_WALLET=true
VITE_WALLET_MODE=phantom
VITE_BACKEND_URL=http://localhost:3001
VITE_EXECUTION_PANEL_REFRESH_MS=10000
VITE_EXECUTION_TRADE_DEFAULT_SOL=0.01
