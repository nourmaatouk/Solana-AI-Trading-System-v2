# =============================================================================
# Solana AI Trading System — consolidated environment reference
# Copy to .env (gitignored) and fill in real values before running.
# =============================================================================

# ── API / CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI backend.
# In production, list only the domains that serve the dashboard.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Optional API key — if set, all endpoints except / and /health require
# the header:  X-API-Key: <value>
# Leave unset (or empty) to run without authentication (local / dev mode).
# API_KEY=

# ── Trading parameters ────────────────────────────────────────────────────────
ACTIVE_SYMBOL=SOL/USDT
# Exposed to the frontend build (Vite requires VITE_ prefix)
VITE_ACTIVE_SYMBOL=SOLUSDT
BTC_SYMBOL=BTC/USDT
EXCHANGE=binance
CONFIDENCE_THRESHOLD=0.69
TAKE_PROFIT_PCT=0.020
STOP_LOSS_PCT=0.015

# ── Backend services ──────────────────────────────────────────────────────────
# URL of the FastAPI (Python) API — consumed by the Node backend proxy.
PYTHON_API=http://localhost:8000
PORT=3001
# URL the Vite dev server proxies to (Node backend).
BACKEND_URL=http://localhost:3001
# Number of klines fetched per market request.
KLINES_LIMIT=500

# ── Exchange endpoints ────────────────────────────────────────────────────────
# Override to point at a testnet or alternative exchange host.
BINANCE_WS_HOST=wss://stream.binance.com:9443
BINANCE_REST_HOST=https://api.binance.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public

# ── Spoofing detection ────────────────────────────────────────────────────────
# Comma-separated list of assets monitored by the spoofing detector.
DEFAULT_ASSETS=BTC,ETH,SOL

# ── Watchlist (Node backend WebSocket streams) ────────────────────────────────
# Comma-separated Binance symbols (no slash, any case) shown in the watchlist.
# The ACTIVE_SYMBOL is always streamed; these are the additional ticker symbols.
WATCHLIST_SYMBOLS=btcusdt,ethusdt,bnbusdt,adausdt,xrpusdt

# ── NLP / Sentiment ───────────────────────────────────────────────────────────
REDIS_URL=redis://<REDIS_HOST>:6379/0
REDIS_TTL_SECONDS=3600
TIMESCALE_DSN=postgresql://postgres:<YOUR_DB_PASSWORD>@localhost:5432/trading
