# =============================================================================
# Solana AI Trading System — consolidated environment reference
# Copy to .env (gitignored) and fill in real values before running.
# =============================================================================

# ── API / CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the FastAPI backend.
# In production, list only the domains that serve the dashboard.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3001

# Optional API key — if set, all endpoints except / and /health require
# the header:  X-API-Key: <value>
# Leave unset (or empty) to run without authentication (local / dev mode).
# API_KEY=

# ── Trading parameters ────────────────────────────────────────────────────────
ACTIVE_SYMBOL=SOL/USDT
# Exposed to the frontend build (Vite requires VITE_ prefix)
VITE_ACTIVE_SYMBOL=SOLUSDT
BTC_SYMBOL=BTC/USDT
EXCHANGE=binance
CONFIDENCE_THRESHOLD=0.69
TAKE_PROFIT_PCT=0.020
STOP_LOSS_PCT=0.015

# ── Backend services ──────────────────────────────────────────────────────────
# URL of the FastAPI (Python) API — consumed by the Node backend proxy.
PYTHON_API=http://localhost:8000
PORT=3001
# URL the Vite dev server proxies to (Node backend).
BACKEND_URL=http://localhost:3001
# Number of klines fetched per market request.
KLINES_LIMIT=500

# ── Exchange endpoints ────────────────────────────────────────────────────────
# Override to point at a testnet or alternative exchange host.
BINANCE_WS_HOST=wss://stream.binance.com:9443
BINANCE_REST_HOST=https://api.binance.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public

# ── Spoofing detection ────────────────────────────────────────────────────────
# Comma-separated list of assets monitored by the spoofing detector.
DEFAULT_ASSETS=BTC,ETH,SOL

# ── Watchlist (Node backend WebSocket streams) ────────────────────────────────
# Comma-separated Binance symbols (no slash, any case) shown in the watchlist.
# The ACTIVE_SYMBOL is always streamed; these are the additional ticker symbols.
WATCHLIST_SYMBOLS=btcusdt,ethusdt,bnbusdt,adausdt,xrpusdt

# ── NLP / Sentiment ───────────────────────────────────────────────────────────
REDIS_URL=redis://<REDIS_HOST>:6379/0
REDIS_TTL_SECONDS=3600
TIMESCALE_DSN=postgresql://postgres:<YOUR_DB_PASSWORD>@localhost:5432/trading

# =============================================================================
# Agentic execution layer (services/execution)
# =============================================================================

# ── Wallet mode ───────────────────────────────────────────────────────────────
# Controls whether the UI/Guardian requires a connected browser wallet.
#   phantom — browser wallet (Phantom/Solflare) required; publicKey sent with
#             every execution request and validated by the Guardian.
#   system  — backend uses SOLANA_PRIVATE_KEY; no browser wallet UI.
#   paper   — no real wallet; paper-trading only.
WALLET_MODE=phantom

# Mode of operation:
#   paper   — simulation only, no Solana RPC calls (DEFAULT, safest)
#   devnet  — real transactions on Solana devnet (requires SOLANA_PRIVATE_KEY)
#   mainnet — blocked unless ALLOW_MAINNET_EXECUTION=true
EXECUTION_MODE=paper

# Guardian must approve every transaction. Do not disable without explicit
# review — the Guardian is the only deterministic safety gate.
REQUIRE_GUARDIAN_APPROVAL=true

# Hard kill-switch for mainnet. Must be explicitly flipped to true to permit
# any mainnet execution, even when EXECUTION_MODE=mainnet.
ALLOW_MAINNET_EXECUTION=false

# Persistent emergency stop. Toggle via:
#   POST /api/execution/emergency-stop
#   POST /api/execution/emergency-resume
# The persisted file lives at
# services/models/classification/data/realtime/emergency_stop.json
EMERGENCY_STOP=false

# Post-decision narration via ElizaOS. Off by default — when enabled, the
# Eliza runtime ONLY produces a human-readable explanation of an already-final
# decision. It never influences Guardian or execution.
ENABLE_ELIZA_NARRATION=false

# ── Solana network ────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Public key used for read-only operations (balance check). Optional in paper.
SOLANA_PUBLIC_KEY=
# Signing key. NEVER commit. Required only for devnet/mainnet execution.
# Format: base58.
SOLANA_PRIVATE_KEY=

# ── Devnet airdrop limits ─────────────────────────────────────────────────────
# Amount airdropped when no amount is specified in the request body.
DEVNET_AIRDROP_AMOUNT_SOL=1
# Hard ceiling — backend clamps any request above this value.
MAX_DEVNET_AIRDROP_SOL=2

# ── Execution-layer limits ────────────────────────────────────────────────────
# Trade size cap, in SOL. Guardian BLOCKs anything above this.
MAX_TRADE_SIZE_SOL=0.1
# Daily loss cap, in SOL.
MAX_DAILY_LOSS_SOL=0.5
# Maximum acceptable spoofing confidence. Trades above this are BLOCKed.
MAX_SPOOFING_CONFIDENCE=0.15
# Maximum age of an upstream AI signal before it's treated as stale (seconds).
SIGNAL_MAX_AGE_SECONDS=300
# Comma-separated list of allowed asset pairs.
ALLOWED_ASSETS=SOL/USDT

# ── Risk tolerance ────────────────────────────────────────────────────────────
# Hard server-side cap for HIGH-risk signals. Even users who set their
# preference to HIGH are blocked when this is false (default: safe).
ALLOW_HIGH_RISK_TRADES=false
# Server-side fallback when the client omits user_risk_level.
# LOW | MEDIUM | HIGH — defaults to LOW (most restrictive).
DEFAULT_USER_RISK_LEVEL=LOW

# ── Auto-executor (Node backend) ─────────────────────────────────────────────
# Poll interval for the fallback polling path (ms). The primary path is
# event-driven via SignalPoller; this is only a safety net.
AUTO_EXECUTOR_POLL_MS=30000
# Amount of SOL submitted per auto-executed trade.
AUTO_EXECUTE_AMOUNT_SOL=0.01
# How long (seconds) a signal key is considered "already processed" to prevent
# duplicate executions from rapid poll/event overlap. The same window is used
# for the persistent dedup log (executed_signal_keys.json).
SIGNAL_DEDUP_WINDOW_SECONDS=300

# Backend auto-execution (paper/system wallet modes) is enabled at runtime by
# the frontend Settings page (Trading Mode = Auto), which writes to
# services/models/classification/data/realtime/auto_execute.json. The backend
# AutoExecutor reads that file on every signal — there is no separate env var.
# Phantom-mode auto-execution is handled entirely by the frontend hook.

# ── Jupiter DEX integration ───────────────────────────────────────────────────
# Set to true to replace the SOL self-transfer with a real Jupiter v6 swap.
# WARNING: Jupiter's quote/swap API is mainnet-only. Enabling this on devnet
# cluster will fail at submission. To use:
#   1. Set SOLANA_RPC_URL to a mainnet RPC endpoint
#   2. Set SOLANA_CLUSTER=mainnet-beta
#   3. Set EXECUTION_MODE=mainnet and ALLOW_MAINNET_EXECUTION=true
JUPITER_SWAP_ENABLED=false
JUPITER_API_URL=https://quote-api.jup.ag/v6
# Slippage tolerance in basis points (50 = 0.5 %).
JUPITER_SLIPPAGE_BPS=50
# Mint of the counter-currency. Default: USDC mainnet.
# For SOL/USDT trading pairs, use: Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
QUOTE_CURRENCY_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# ── On-chain Guardian (future) ────────────────────────────────────────────────
# Program ID of the deployed Anchor Guardian. Leave empty until deployed.
# GUARDIAN_PROGRAM_ID=

# ── Frontend exposure (Vite) ─────────────────────────────────────────────────
# Auto-refresh interval for the execution panel (ms)
VITE_EXECUTION_PANEL_REFRESH_MS=10000
# Default amount prefilled in the execution panel (SOL)
VITE_EXECUTION_TRADE_DEFAULT_SOL=0.01

# ── Wallet / Solana (Vite — exposed to browser) ───────────────────────────────
# Must stay in sync with SOLANA_CLUSTER and SOLANA_RPC_URL above.
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
# Set to false to disable Phantom/Solflare wallet UI entirely.
VITE_ENABLE_PHANTOM_WALLET=true
# Must stay in sync with WALLET_MODE above.
VITE_WALLET_MODE=phantom
# Backend base URL — only needed when running outside the Vite proxy.
VITE_BACKEND_URL=http://localhost:3001
