# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Node dependencies
node_modules/

# Build outputs — covered by the top-level `dist/` rule above;
# listed here for discoverability when grepping for app paths.
apps/*/dist/
apps/*/*/dist/
*.tsbuildinfo

# Environment files — keep .env.example, never commit real secrets
.env
.env.local
.env.*.local

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Distribution / packaging
*.whl
*.tar.gz
*.zip

# ML model weights and large binaries
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.ckpt
*.pkl
*.joblib
*.npz
*.zip

# Trained model artifacts and generated result JSON files (all reproducible)
services/models/models/

# Data files — processed outputs and raw downloads (large, reproducible)
**/data/raw/
**/data/processed/
**/data/logs/
# Runtime state for the execution layer lives under **/data/realtime/ and is
# intentionally per-environment. Anything in this directory is ignored,
# including the files the dashboard writes at runtime:
#   - emergency_stop.json
#   - auto_execute.json
#   - user_risk_level.json
#   - max_trade_size_sol.json
#   - executed_signal_keys.json
#   - daily_volume.json
#   - last_execution.json
#   - execution_history.jsonl
#   - paper_trading_*.json
#   - last_fused_decision.json (written by the Python pipeline)
**/data/realtime/
**/data/cache/
services/models/nlp/data/
*.parquet
*.h5
*.hdf5

# Generated plots (reproducible by re-running training scripts)
**/plots/

# Reports and generated HTML (reproducible via scripts)
**/reports/*.html
**/reports/images/

# Logs
*.log
**/logs/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
**/.vscode/
**/.idea/
*.swp
*.swo

# pytest / coverage
**/.pytest_cache/
**/.coverage
**/htmlcov/
