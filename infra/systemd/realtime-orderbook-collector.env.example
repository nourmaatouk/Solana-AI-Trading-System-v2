# Copy this file to:
#   /etc/default/realtime-orderbook-collector
#
# Then edit APP_DIR and PYTHON_BIN for the deployment host.

# Absolute path to the repository root.
APP_DIR=/opt/solana-ai-trading-system

# Python executable with the classification dependencies installed.
# Recommended: a virtualenv inside APP_DIR, for example:
#   cd /opt/solana-ai-trading-system
#   python3 -m venv .venv
#   .venv/bin/pip install -r services/models/classification/requirements.txt
PYTHON_BIN=/opt/solana-ai-trading-system/.venv/bin/python

# Binance partial-depth stream settings.
ORDERBOOK_SYMBOL=solusdt
ORDERBOOK_TOP_N=10
ORDERBOOK_FLUSH_INTERVAL=60
ORDERBOOK_MAX_ROWS=180
