[Unit]
Description=Solvanta AI — Realtime Pipeline Scheduler
Documentation=https://github.com/nourmaatouk/Solana-AI-Trading-System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/solvanta/scheduler.env
WorkingDirectory=${APP_DIR}
ExecStart=${PYTHON_BIN} ${APP_DIR}/services/models/classification/realtime_scheduler.py \
    --interval ${SCHEDULER_INTERVAL}
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
